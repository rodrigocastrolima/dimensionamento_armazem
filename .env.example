# Copy to .env for local runs, or set these as real secrets/env vars on
# whatever platform hosts the container (see DEPLOYMENT.md). Never commit
# a real .env -- see .gitignore.

# Which dados/clients/<name>.json to load. Same default as if unset ("sia"),
# spelled out here so a deployment's env config is self-documenting.
WAREHOUSE_CLIENT=sia

# Only if you need to point at a different workbook than the one in that
# client's config, without editing the JSON (e.g. comparing two versions).
# WAREHOUSE_MASTER_DATA=dados/master_data_classificado_v3.xlsx

# Only needed once a client's dados/clients/<name>.json has
# "data_source": "supabase" -- see supabase/README.md and NEEDS_HUMAN.md.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server bind address/port (see run_web.py, Dockerfile). Local default is
# 127.0.0.1:8000; most hosting platforms set PORT for you automatically.
# HOST=0.0.0.0
# PORT=8000
